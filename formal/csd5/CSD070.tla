---------------------------- MODULE CSD070 ----------------------------
(* CSD-070, the screen as a function of its inputs. GENERATED by
   packaging/check_csd5.py --write-tla from the card's csd:inputs, csd:view and
   csd:acts blocks; edit the card, not this file. The state is one record of
   strings: x_ context, l_ local values, r_ read outcomes, c_ what an answer
   carries, p_ previews, q_ the inputs an answer was taken over, and `sheet`.
   The Python explorer reaches 134928 distinct states with this model; TLC
   should report the same number. See formal/csd5/README.md. *)
VARIABLE st

\* What a text input's relation to an answer taken over it can become when the
\* person edits it to blank or filled: `-` no answer is held, `blank` the asked
\* value was blank, `same` and `diff` the asked value was filled.
Rel(q, c) == IF q = "-" THEN {"-"} ELSE IF q = "blank" THEN {"blank"}
             ELSE IF c = "blank" THEN {"diff"} ELSE {"same", "diff"}
Close(s) == [s EXCEPT !.sheet = "none"]
Ask_standing(s) == [s EXCEPT !.r_standing = "pending", !.c_standing_refused = "-", !.c_standing_arm = "-", !.c_standing_fold = "-", !.c_standing_escalation = "-", !.c_standing_objections = "-", !.c_standing_prices = "-", !.q_standing_cohort = s.l_cohort, !.q_standing_cohort_key = IF s.l_cohort_key = "blank" THEN "blank" ELSE "same", !.q_standing_action = IF s.l_action = "blank" THEN "blank" ELSE "same"]
Call_dry_run(s) == [s EXCEPT !.p_dry_run = "taken", !.q_dry_run_cohort = s.l_cohort, !.q_dry_run_cohort_key = IF s.l_cohort_key = "blank" THEN "blank" ELSE "same", !.q_dry_run_action = IF s.l_action = "blank" THEN "blank" ELSE "same", !.q_dry_run_dismiss_grounds = IF s.l_dismiss_grounds = "blank" THEN "blank" ELSE "same"]
Open_ballot(s) == [s EXCEPT !.sheet = "ballot"]
Open_dismiss(s) == [s EXCEPT !.sheet = "dismiss"]
Open_raise(s) == [s EXCEPT !.sheet = "raise"]
Set_ballot_overrule(s) == [s EXCEPT !.l_ballot = "overrule"]
Set_ballot_uphold(s) == [s EXCEPT !.l_ballot = "uphold"]
Set_cosigners_none(s) == [s EXCEPT !.l_cosigners = "none"]
Set_cosigners_some(s) == [s EXCEPT !.l_cosigners = "some"]
Set_result_answer(s) == [s EXCEPT !.l_result = "answer"]
Set_result_none(s) == [s EXCEPT !.l_result = "none"]
Set_result_preview(s) == [s EXCEPT !.l_result = "preview"]
Set_write_error_false(s) == [s EXCEPT !.l_write_error = "false"]
Set_write_error_true(s) == [s EXCEPT !.l_write_error = "true"]
Toggle_lifting(s) == [s EXCEPT !.l_lifting = IF @ = "true" THEN "false" ELSE "true"]
Drop_ballot(s) == [s EXCEPT !.l_ballot = "unset"]
Drop_ballot_grounds(s) == [s EXCEPT !.l_ballot_grounds = "blank"]
Drop_cosigner_classical(s) == [s EXCEPT !.l_cosigner_classical = "blank"]
Drop_cosigner_key(s) == [s EXCEPT !.l_cosigner_key = "blank"]
Drop_cosigners(s) == [s EXCEPT !.l_cosigners = "none"]
Drop_dismiss_grounds(s) == [s EXCEPT !.l_dismiss_grounds = "blank", !.q_dry_run_dismiss_grounds = IF @ \in {"same", "diff"} THEN "diff" ELSE @]
Drop_dry_run(s) == [s EXCEPT !.p_dry_run = "none", !.q_dry_run_cohort = "-", !.q_dry_run_cohort_key = "-", !.q_dry_run_action = "-", !.q_dry_run_dismiss_grounds = "-"]
Drop_lifting(s) == [s EXCEPT !.l_lifting = "false"]
Drop_raise_grounds(s) == [s EXCEPT !.l_raise_grounds = "blank"]
Drop_result(s) == [s EXCEPT !.l_result = "none"]
Drop_standing(s) == [s EXCEPT !.r_standing = "idle", !.c_standing_refused = "-", !.c_standing_arm = "-", !.c_standing_fold = "-", !.c_standing_escalation = "-", !.c_standing_objections = "-", !.c_standing_prices = "-", !.q_standing_cohort = "-", !.q_standing_cohort_key = "-", !.q_standing_action = "-"]
Drop_write_error(s) == [s EXCEPT !.l_write_error = "false"]
Match_standing(s) == (s.q_standing_cohort = s.l_cohort) /\ ((s.q_standing_cohort_key = "blank" /\ s.l_cohort_key = "blank") \/ s.q_standing_cohort_key = "same") /\ ((s.q_standing_action = "blank" /\ s.l_action = "blank") \/ s.q_standing_action = "same")
Match_dry_run(s) == (s.q_dry_run_cohort = s.l_cohort) /\ ((s.q_dry_run_cohort_key = "blank" /\ s.l_cohort_key = "blank") \/ s.q_dry_run_cohort_key = "same") /\ ((s.q_dry_run_action = "blank" /\ s.l_action = "blank") \/ s.q_dry_run_action = "same") /\ ((s.q_dry_run_dismiss_grounds = "blank" /\ s.l_dismiss_grounds = "blank") \/ s.q_dry_run_dismiss_grounds = "same")

\* A value that lives only while its part of the screen is drawn returns to its
\* start when it is not. Applied 2 time(s): the explorer never needed more.
Norm(s) ==
    LET n1 == IF (s.r_standing = "ok") THEN s ELSE Drop_raise_grounds(s)
        n2 == IF (((n1.r_standing = "ok") /\ (~(n1.c_standing_refused = "true"))) /\ (n1.c_standing_objections = "true")) THEN n1 ELSE Drop_ballot_grounds(n1)
        n3 == IF (n2.sheet = "ballot") THEN n2 ELSE Drop_ballot(n2)
        n4 == IF ((((n3.r_standing = "ok") /\ (~(n3.c_standing_refused = "true"))) /\ (n3.c_standing_objections = "true")) \/ (n3.p_dry_run = "taken")) THEN n3 ELSE Drop_lifting(n3)
        n5 == IF ((n4.l_lifting = "true") \/ (n4.p_dry_run = "taken")) THEN n4 ELSE Drop_dismiss_grounds(n4)
        n6 == IF (((n5.l_lifting = "true") /\ (((n5.r_standing = "ok") /\ (~(n5.c_standing_refused = "true"))) /\ (n5.c_standing_objections = "true"))) /\ (n5.p_dry_run = "taken")) THEN n5 ELSE Drop_cosigner_key(n5)
        n7 == IF (((n6.l_lifting = "true") /\ (((n6.r_standing = "ok") /\ (~(n6.c_standing_refused = "true"))) /\ (n6.c_standing_objections = "true"))) /\ (n6.p_dry_run = "taken")) THEN n6 ELSE Drop_cosigner_classical(n6)
        n8 == IF (n7.p_dry_run = "taken") THEN n7 ELSE Drop_cosigners(n7)
        n9 == IF ((n8.l_result # "preview") \/ (n8.p_dry_run = "taken")) THEN n8 ELSE Drop_result(n8)
        n10 == IF (n9.r_standing = "ok") THEN n9 ELSE Drop_write_error(n9)
        n11 == IF (((n10.r_standing # "ok") \/ (n10.c_standing_refused = "true")) \/ (((n10.r_standing = "ok") /\ (~(n10.c_standing_refused = "true"))) /\ (n10.c_standing_objections = "true"))) THEN n10 ELSE Drop_dry_run(n10)
        n12 == IF ((n11.r_standing = "ok") /\ (n11.l_raise_grounds # "blank")) \/ n11.sheet # "raise" THEN n11 ELSE Close(n11)
        n13 == IF ((((n12.r_standing = "ok") /\ (~(n12.c_standing_refused = "true"))) /\ (n12.c_standing_objections = "true")) /\ (n12.l_ballot_grounds # "blank")) \/ n12.sheet # "ballot" THEN n12 ELSE Close(n12)
        n14 == IF (((n13.r_standing = "ok") /\ (~(n13.c_standing_refused = "true"))) /\ (n13.c_standing_objections = "true")) \/ n13.sheet # "dismiss" THEN n13 ELSE Close(n13)
    IN  n14

Init == st \in {
        [x_window |-> window0,
         l_cohort |-> "family",
         l_cohort_key |-> "blank",
         l_action |-> "blank",
         l_raise_grounds |-> "blank",
         l_ballot_grounds |-> "blank",
         l_ballot |-> "unset",
         l_lifting |-> "false",
         l_dismiss_grounds |-> "blank",
         l_cosigner_key |-> "blank",
         l_cosigner_classical |-> "blank",
         l_cosigners |-> "none",
         l_result |-> "none",
         l_write_error |-> "false",
         r_standing |-> "idle",
         c_standing_refused |-> "-",
         c_standing_arm |-> "-",
         c_standing_fold |-> "-",
         c_standing_escalation |-> "-",
         c_standing_objections |-> "-",
         c_standing_prices |-> "-",
         p_dry_run |-> "none",
         q_standing_cohort |-> "-",
         q_standing_cohort_key |-> "-",
         q_standing_action |-> "-",
         q_dry_run_cohort |-> "-",
         q_dry_run_cohort_key |-> "-",
         q_dry_run_action |-> "-",
         q_dry_run_dismiss_grounds |-> "-",
         sheet |-> "none"] :
        window0 \in {"compact", "wide"}}

Answers_standing == {a \in [refused : {"false", "true"}, arm : {"unreadable", "action_unknown", "cohort_unknown", "not_governed", "quiet", "objected", "stood", "reversed"}, fold : {"false", "true"}, escalation : {"false", "true"}, objections : {"false", "true"}, prices : {"false", "true"}] : ((~(a.refused = "true")) \/ (((((a.arm = "unreadable") /\ (~(a.fold = "true"))) /\ (~(a.escalation = "true"))) /\ (~(a.objections = "true"))) /\ (~(a.prices = "true")))) /\ ((a.arm \in {"quiet", "objected", "stood", "reversed"}) \/ ((~(a.fold = "true")) /\ (~(a.escalation = "true")))) /\ (((~(a.objections = "true")) \/ (a.fold = "true")) \/ (a.escalation = "true"))}

Answer_standing ==
    /\ st.r_standing = "pending"
    /\ \/ st' = Norm(Norm([st EXCEPT !.r_standing = "failed"]))
       \/ \E a \in Answers_standing : st' = Norm(Norm([st EXCEPT !.r_standing = "ok", !.c_standing_refused = a.refused, !.c_standing_arm = a.arm, !.c_standing_fold = a.fold, !.c_standing_escalation = a.escalation, !.c_standing_objections = a.objections, !.c_standing_prices = a.prices]))

Confirm_raise ==
    /\ st.sheet = "raise"
    /\ st' \in {Norm(Norm(t)) : t \in ({Set_write_error_true(Close(st))} \cup {Ask_standing(Set_result_answer(Drop_raise_grounds(Close(st))))} \cup {Set_write_error_false(Set_result_answer(Close(st)))})}

Cancel_raise ==
    /\ st.sheet = "raise"
    /\ st' \in {Norm(Norm(t)) : t \in {Close(st)}}

Confirm_ballot ==
    /\ st.sheet = "ballot"
    /\ st' \in {Norm(Norm(t)) : t \in ({Set_write_error_true(Close(st))} \cup {Ask_standing(Set_result_answer(Close(st)))} \cup {Set_write_error_false(Set_result_answer(Close(st)))})}

Cancel_ballot ==
    /\ st.sheet = "ballot"
    /\ st' \in {Norm(Norm(t)) : t \in {Close(st)}}

Confirm_dismiss ==
    /\ st.sheet = "dismiss"
    /\ st' \in {Norm(Norm(t)) : t \in ({Set_write_error_true(Close(st))} \cup {Ask_standing(Set_result_answer(Drop_dry_run(Close(st))))} \cup {Set_write_error_false(Set_result_answer(Close(st)))})}

Cancel_dismiss ==
    /\ st.sheet = "dismiss"
    /\ st' \in {Norm(Norm(t)) : t \in {Close(st)}}

Pick_cohort ==
    /\ st.sheet = "none"
    /\ TRUE
    /\ TRUE
    /\ \E v \in {"family", "community", "affiliations"} \ {st.l_cohort} :
         st' \in {Norm(Norm(t)) : t \in {Drop_dry_run(Drop_standing([st EXCEPT !.l_cohort = v]))}}

Edit_cohort_key ==
    /\ st.sheet = "none"
    /\ TRUE
    /\ TRUE
    /\ \E c \in {"blank", "filled"} : \E r0 \in Rel(st.q_standing_cohort_key, c) : \E r1 \in Rel(st.q_dry_run_cohort_key, c) :
         /\ ~(c = st.l_cohort_key /\ (c = "blank" \/ (r0 = st.q_standing_cohort_key /\ r1 = st.q_dry_run_cohort_key /\ "same" \in {r0, r1})))
         /\ st' \in {Norm(Norm(t)) : t \in {Drop_dry_run(Drop_standing([st EXCEPT !.l_cohort_key = c, !.q_standing_cohort_key = r0, !.q_dry_run_cohort_key = r1]))}}

Edit_action ==
    /\ st.sheet = "none"
    /\ TRUE
    /\ TRUE
    /\ \E c \in {"blank", "filled"} : \E r0 \in Rel(st.q_standing_action, c) : \E r1 \in Rel(st.q_dry_run_action, c) :
         /\ ~(c = st.l_action /\ (c = "blank" \/ (r0 = st.q_standing_action /\ r1 = st.q_dry_run_action /\ "same" \in {r0, r1})))
         /\ st' \in {Norm(Norm(t)) : t \in {Drop_dry_run(Drop_standing([st EXCEPT !.l_action = c, !.q_standing_action = r0, !.q_dry_run_action = r1]))}}

Edit_objection_grounds ==
    /\ st.sheet = "none"
    /\ (st.r_standing = "ok")
    /\ TRUE
    /\ \E c \in {"blank", "filled"} :
         /\ ~(c = st.l_raise_grounds /\ (c = "blank"))
         /\ st' \in {Norm(Norm(t)) : t \in {[st EXCEPT !.l_raise_grounds = c]}}

Edit_ballot_grounds ==
    /\ st.sheet = "none"
    /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true"))
    /\ TRUE
    /\ \E c \in {"blank", "filled"} :
         /\ ~(c = st.l_ballot_grounds /\ (c = "blank"))
         /\ st' \in {Norm(Norm(t)) : t \in {[st EXCEPT !.l_ballot_grounds = c]}}

Edit_dismiss_grounds ==
    /\ st.sheet = "none"
    /\ ((st.l_lifting = "true") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true")))
    /\ TRUE
    /\ \E c \in {"blank", "filled"} : \E r0 \in Rel(st.q_dry_run_dismiss_grounds, c) :
         /\ ~(c = st.l_dismiss_grounds /\ (c = "blank" \/ (r0 = st.q_dry_run_dismiss_grounds /\ "same" \in {r0})))
         /\ st' \in {Norm(Norm(t)) : t \in {Drop_dry_run([st EXCEPT !.l_dismiss_grounds = c, !.q_dry_run_dismiss_grounds = r0])}}

Edit_cosigner_key ==
    /\ st.sheet = "none"
    /\ ((st.l_lifting = "true") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true")))
    /\ (st.p_dry_run = "taken")
    /\ \E c \in {"blank", "filled"} :
         /\ ~(c = st.l_cosigner_key /\ (c = "blank"))
         /\ st' \in {Norm(Norm(t)) : t \in {[st EXCEPT !.l_cosigner_key = c]}}

Edit_cosigner_classical ==
    /\ st.sheet = "none"
    /\ ((st.l_lifting = "true") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true")))
    /\ (st.p_dry_run = "taken")
    /\ \E c \in {"blank", "filled"} :
         /\ ~(c = st.l_cosigner_classical /\ (c = "blank"))
         /\ st' \in {Norm(Norm(t)) : t \in {[st EXCEPT !.l_cosigner_classical = c]}}

Press_back ==
    /\ st.sheet = "none"
    /\ (st.x_window = "wide")
    /\ TRUE
    /\ st' \in {Norm(Norm(t)) : t \in {st}}

Press_read ==
    /\ st.sheet = "none"
    /\ TRUE
    /\ (((st.l_cohort_key # "blank") /\ (st.l_action # "blank")) /\ (st.r_standing # "pending"))
    /\ st' \in {Norm(Norm(t)) : t \in {Ask_standing(st)}}

Press_object ==
    /\ st.sheet = "none"
    /\ (st.r_standing = "ok")
    /\ (st.l_raise_grounds # "blank")
    /\ st' \in {Norm(Norm(t)) : t \in {Open_raise(st)}}

Press_uphold ==
    /\ st.sheet = "none"
    /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true"))
    /\ (st.l_ballot_grounds # "blank")
    /\ st' \in {Norm(Norm(t)) : t \in {Open_ballot(Set_ballot_uphold(st))}}

Press_overrule ==
    /\ st.sheet = "none"
    /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true"))
    /\ (st.l_ballot_grounds # "blank")
    /\ st' \in {Norm(Norm(t)) : t \in {Open_ballot(Set_ballot_overrule(st))}}

Press_lift_disclose ==
    /\ st.sheet = "none"
    /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true"))
    /\ TRUE
    /\ st' \in {Norm(Norm(t)) : t \in {Toggle_lifting(st)}}

Press_dismiss_dry_run ==
    /\ st.sheet = "none"
    /\ ((st.l_lifting = "true") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true")))
    /\ (st.l_dismiss_grounds # "blank")
    /\ st' \in {Norm(Norm(t)) : t \in ({Set_write_error_true(Drop_dry_run(Drop_cosigner_classical(Drop_cosigner_key(Set_cosigners_none(st)))))} \cup {Set_write_error_false(Set_result_preview(Call_dry_run(Drop_cosigner_classical(Drop_cosigner_key(Set_cosigners_none(st))))))} \cup {Set_write_error_false(Set_result_answer(Drop_dry_run(Drop_cosigner_classical(Drop_cosigner_key(Set_cosigners_none(st))))))})}

Press_add_cosigner ==
    /\ st.sheet = "none"
    /\ ((st.l_lifting = "true") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true")))
    /\ (((st.p_dry_run = "taken") /\ (st.l_cosigner_key # "blank")) /\ (st.l_cosigner_classical # "blank"))
    /\ st' \in {Norm(Norm(t)) : t \in {Drop_cosigner_classical(Drop_cosigner_key(Set_cosigners_some(st)))}}

Press_remove_cosigner ==
    /\ st.sheet = "none"
    /\ (((st.l_lifting = "true") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true"))) /\ (st.l_cosigners = "some"))
    /\ TRUE
    /\ st' \in {Norm(Norm(t)) : t \in {Set_cosigners_none(st)}}

Press_dismiss_submit ==
    /\ st.sheet = "none"
    /\ ((st.l_lifting = "true") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true")))
    /\ (st.p_dry_run = "taken")
    /\ st' \in {Norm(Norm(t)) : t \in {Open_dismiss(st)}}

Press_dismiss_abandon ==
    /\ st.sheet = "none"
    /\ ((st.l_lifting = "true") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true")))
    /\ TRUE
    /\ st' \in {Norm(Norm(t)) : t \in {Drop_dry_run(st)}}

Press_clear_result ==
    /\ st.sheet = "none"
    /\ (st.l_result # "none")
    /\ TRUE
    /\ st' \in {Norm(Norm(t)) : t \in {Set_result_none(st)}}

Next ==
    \/ Answer_standing
    \/ Confirm_raise
    \/ Cancel_raise
    \/ Confirm_ballot
    \/ Cancel_ballot
    \/ Confirm_dismiss
    \/ Cancel_dismiss
    \/ Pick_cohort
    \/ Edit_cohort_key
    \/ Edit_action
    \/ Edit_objection_grounds
    \/ Edit_ballot_grounds
    \/ Edit_dismiss_grounds
    \/ Edit_cosigner_key
    \/ Edit_cosigner_classical
    \/ Press_back
    \/ Press_read
    \/ Press_object
    \/ Press_uphold
    \/ Press_overrule
    \/ Press_lift_disclose
    \/ Press_dismiss_dry_run
    \/ Press_add_cosigner
    \/ Press_remove_cosigner
    \/ Press_dismiss_submit
    \/ Press_dismiss_abandon
    \/ Press_clear_result
Spec == Init /\ [][Next]_st

Inv_L11_answer_is_about_its_question ==
    (st.r_standing # "idle" => Match_standing(st))
    /\ (st.p_dry_run = "taken" => Match_dry_run(st))
Inv_L12_raise_from_raise_shown_is_sent ==
    st.sheet = "raise" =>
    /\ (TRUE)
    /\ ((st.r_standing = "ok"))
Inv_L12_ballot_from_ballot_shown_is_sent ==
    st.sheet = "ballot" =>
    /\ (TRUE)
    /\ ((((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true")))
Inv_L7_dismiss_preview_is_execution ==
    st.sheet = "dismiss" => (st.p_dry_run = "taken" /\ Match_dry_run(st))
Inv_L12_dismiss_from_dismiss_shown_is_sent ==
    st.sheet = "dismiss" =>
    /\ (TRUE)
    /\ (((st.l_lifting = "true") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_objections = "true"))))
Inv_L2_standing_exactly_one_state ==
    TRUE =>
    /\ ((st.r_standing = "idle") \/ (st.r_standing = "pending") \/ (st.r_standing = "failed") \/ ((st.r_standing = "ok") /\ (st.c_standing_refused = "true")) \/ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ ((st.c_standing_arm = "unreadable") \/ ((st.c_standing_arm \in {"quiet", "objected", "stood", "reversed"}) /\ (~(st.c_standing_fold = "true"))))) \/ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_arm \in {"action_unknown", "cohort_unknown"})) \/ ((((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_arm = "quiet")) /\ (st.c_standing_fold = "true")) \/ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ ((st.c_standing_arm = "not_governed") \/ ((st.c_standing_arm \in {"objected", "stood", "reversed"}) /\ (st.c_standing_fold = "true")))))
    /\ ~((st.r_standing = "idle") /\ (st.r_standing = "pending"))
    /\ ~((st.r_standing = "idle") /\ (st.r_standing = "failed"))
    /\ ~((st.r_standing = "idle") /\ ((st.r_standing = "ok") /\ (st.c_standing_refused = "true")))
    /\ ~((st.r_standing = "idle") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ ((st.c_standing_arm = "unreadable") \/ ((st.c_standing_arm \in {"quiet", "objected", "stood", "reversed"}) /\ (~(st.c_standing_fold = "true"))))))
    /\ ~((st.r_standing = "idle") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_arm \in {"action_unknown", "cohort_unknown"})))
    /\ ~((st.r_standing = "idle") /\ ((((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ (st.c_standing_arm = "quiet")) /\ (st.c_standing_fold = "true")))
    /\ ~((st.r_standing = "idle") /\ (((st.r_standing = "ok") /\ (~(st.c_standing_refused = "true"))) /\ ((st.c_standing_arm = "not_governed") \/ ((st.c_standing_arm \in {"objected", "stood", "reversed"}) /\ (st.c_standing_fold = "true")))))
    /\ ~((st.r_standing = "pending") /\ (st.r_standing = "failed"))
    /\ ~((st.r_standing = "pending") /\ ((st.r_standing = "ok") /\ (st.c_standing_refused = "true")))
